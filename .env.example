# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Proveedor activo: gemini | openrouter
# Si usás OpenRouter, cambiá LLM_PROVIDER=openrouter y completá OPENROUTER_API_KEY.
LLM_PROVIDER=gemini

# --- Gemini API directo ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# --- OpenRouter (API compatible con OpenAI) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_FALLBACK_MODELS=

# Opcionales (valores por defecto recomendados)
# AGENT_MAX_LLM_CALLS=10
# GEMINI_REQUEST_TIMEOUT_S=12
# GEMINI_QUESTION_BUDGET_S=60
# GEMINI_MAX_RETRIES=1
